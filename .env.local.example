# Copy to .env.local and fill in. Never commit .env.local.

# Public origin of the deployed site. Used for canonical URLs, sitemap and
# absolute Open Graph image URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://koolkalakaars.com

# Google Apps Script web-app URL that writes free-ticket requests to a Sheet.
# Server-side only: this is never exposed to the browser.
# Setup instructions: docs/APPS_SCRIPT.md
TICKET_ENDPOINT_URL=
